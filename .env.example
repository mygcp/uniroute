# ─────────────────────────────────────────────────────────────
#  UniRoute environment template
#
#  PLUG & PLAY: aplikasi tetap jalan tanpa file ini sama sekali.
#  Satu-satunya yang disarankan diganti: PASSWORD.
#  Baris yang diawali '#' opsional — nilai default sudah ditulis.
# ─────────────────────────────────────────────────────────────

# Password login dashboard (WAJIB diganti di produksi)
PASSWORD=CHANGEME

# Port server produksi (`bun run start`) — dev selalu :5173
PORT=3000

# Alamat gateway yang dipakai client / ditulis ke config agent
BASE_URL=http://localhost:3000

# Path file SQLite (folder + file dibuat otomatis)
DATABASE_URL=./data/uniroute.db

# ── Opsional ─────────────────────────────────────────────────

# Kunci enkripsi secret (mis. agar client key bisa di-reveal/reuse).
# Isi string acak apa pun; wajib ada SEBELUM key dibuat.
#API_KEY_SECRET=

# Izinkan dekripsi key tersimpan (bisa juga diaktifkan dari web:
# AI Agents → Stored API keys).
#ALLOW_API_KEY_REVEAL=1

# MCP HTTP transport (bun mcp-server.ts --http):
# bearer token opsional + port override
#UNIROUTE_MCP_TOKEN=
#UNIROUTE_MCP_PORT=3007
# Override home untuk config harness/backup (biasanya tidak perlu)
#UNIROUTE_AGENT_HOME=
